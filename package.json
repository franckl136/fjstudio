{
  "name": "folk-and-joy-studio",
  "version": "0.4.0-rc.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup:local": "node scripts/setup-local.ts",
    "setup:identity": "node scripts/setup-identity.ts",
    "start:product": "node --env-file=.env.local --env-file=.env.human.local src/main.ts",
    "control:worker": "node --env-file=.env.local scripts/control-worker.ts",
    "access:local": "node --env-file=.env.local scripts/access-local.ts",
    "db:up": "node scripts/db-local.ts up",
    "db:stop": "node scripts/db-local.ts stop",
    "migrate": "node --env-file=.env.local scripts/product-maintenance.ts migrate",
    "start": "node --env-file=.env.local src/main.ts",
    "runner": "node --env-file=.env.local src/runner-main.ts",
    "quality:g52": "node scripts/g52-quality.mjs",
    "quality:studio": "node --env-file=.env.local scripts/product-campaign.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env.local --test --test-concurrency=1 test/*.test.ts",
    "maintenance": "node --env-file=.env.local scripts/product-maintenance.ts once",
    "maintenance:watch": "node --env-file=.env.local scripts/product-maintenance.ts watch",
    "backup:verify": "node --env-file=.env.local scripts/backup-verify.ts",
    "vault:key": "node scripts/product-vault.ts key",
    "vault:pack": "node scripts/product-vault.ts pack",
    "vault:unpack": "node scripts/product-vault.ts unpack",
    "test:browser": "node --env-file=.env.local scripts/product-workspace-browser.mjs",
    "backup": "node scripts/backup.ts",
    "restore": "node scripts/restore.ts"
  },
  "dependencies": {
    "@prisma/prisma-schema-wasm": "7.1.1-3.c2990dca591cba766e3b7ef5d9e8a84796e47ab7",
    "libpg-query": "18.2.7",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "playwright-core": "1.65.1",
    "typescript": "^5.9.3"
  }
}
